# Example environment variables for demo application
# Copy this file to .env and adjust values as needed

# Ports
PORT_FRONTEND=3000
PORT_BACKEND=8000

# Database
DB_NAME=demo
DB_USER=user
DB_PASSWORD=password
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Application settings
APP_ENV=development
DEBUG=true