    { "id": "temporal", "lane": "authority", "col": 2, "type": "messagebus", "label": "Temporal", "sublabel": "Nouveaux runs" },
    { "id": "readonly", "lane": "authority", "col": 3, "type": "database", "label": "Read-only", "sublabel": "Aucun job autoritaire" },
