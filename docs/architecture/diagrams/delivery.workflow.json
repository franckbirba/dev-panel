    { "from": "experience", "to": "ready" },
    { "from": "ready", "to": "build", "variant": "emphasis" },
    { "from": "build", "to": "verify" },
    { "from": "verify", "to": "review" },
    { "from": "review", "to": "release_done", "variant": "emphasis" }
  ]
