    "requiredPaths": [
      { "from": "intake", "to": "ready" },
      { "from": "ready", "to": "release_done" }
    ]
  },
  "nodes": [
    { "id": "intake", "lane": "delivery", "col": 0, "type": "external", "label": "Intake", "sublabel": "Demande originale" },
    { "id": "discovery", "lane": "delivery", "col": 1, "type": "backend", "label": "Discovery", "sublabel": "Problème et risques" },
    { "id": "specification", "lane": "delivery", "col": 2, "type": "backend", "label": "Specification", "sublabel": "Critères testables" },
    { "id": "experience", "lane": "delivery", "col": 3, "type": "frontend", "label": "Experience", "sublabel": "PrototypeRelease si UI" },
    { "id": "ready", "lane": "evidence", "col": 3, "type": "security", "label": "Ready", "sublabel": "Definition of Ready" },
    { "id": "build", "lane": "delivery", "col": 4, "type": "backend", "label": "Build", "sublabel": "CLI · commits · PR" },
    { "id": "verify", "lane": "evidence", "col": 4, "type": "security", "label": "Verify", "sublabel": "Tests et preuves", "tag": "rework → build" },
    { "id": "review", "lane": "evidence", "col": 5, "type": "security", "label": "Review", "sublabel": "Acceptation du head SHA", "tag": "attente libre" },
    { "id": "release_done", "lane": "delivery", "col": 5, "type": "cloud", "label": "Release + Done", "sublabel": "Deploy · Plane" }
