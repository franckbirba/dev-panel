    { "id": "produce", "label": "Produire et vérifier", "fromCol": 3, "toCol": 4, "variant": "emphasis" },
    { "id": "ship", "label": "Livrer et observer", "fromCol": 5, "toCol": 5, "variant": "dashed" }
  ],
  "mainPath": ["intake", "discovery", "specification", "experience", "ready", "build", "verify", "review", "release_done"],
  "semanticChecks": {
