# scripts/bench/bench.env — copie ce fichier en bench.env et remplis.
# bench.env est git-ignoré (il porte des secrets).

# Cible du bench
BENCH_REPO=franckbirba/devpanl-bench-sandbox
BENCH_PROJECT_ID=cb6f8e04-b826-486c-8288-16bd4cf1df3b      # UUID devpanel (créé 2026-08-19)
BENCH_PLANE_PROJECT_ID=04ffca20-7d2c-47ec-80b5-5afd5fb724a9  # UUID Plane du projet BENCH

# Control plane
API_BASE=https://devpanl.dev
ADMIN_API_KEY=

# Plane (création des work items de scénario)
PLANE_BASE_URL=https://plane.devpanl.dev
PLANE_WORKSPACE_SLUG=devpanl
PLANE_API_KEY=

# Capacités moteur livrées — gouverne les NOT_IMPLEMENTED. Ajouter au fil de
# la Phase C : dispatch_wave failure_taxonomy timeout_budget
# worker_control_cancel boot_reconciliation graph_loops
IMPLEMENTED_CAPS=""

# D6 uniquement — kill brutal du worker (adapter à l'unité systemd réelle)
BENCH_KILL_WORKER_CMD="ssh deploy@62.238.0.167 'pkill -9 -f \"node src/worker/index.js\" || true'"
